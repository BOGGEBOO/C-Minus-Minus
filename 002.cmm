int sums(){
    int sum = 0;
    for(int i = 1; i <= 512; i++){
        sum += i;
    }
    return sum;
}

int product(){
    int prod = 1;
    for(int i = 1; i <= 512; i++){
        prod *= i;
    }
    return prod;
}



