int sums(){
    int sum = 0;
    for(int i = 1; i <= 512; i++){
        sum += i;
    }
    return sum;
}

int product(){
    int prod = 1;
    for(int i = 1; i <= 512; i++){
        prod = prod * i;
    }
    return prod;
}



void codeGoBrrrrrrrrrrr(){
    # fixa så att string kan innehålla siffror
    
    print("Summan av alla tal upp till femhundratolv:");
    print(sums());
    print("Produkten av alla tal upp till femhundratolv:");
    print(product());
}
