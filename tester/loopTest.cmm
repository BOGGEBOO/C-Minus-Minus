void codeGoBrrrrrrrrrrr(){
    string fel = "FEL!!!";
    int x = 0;
    for(int i = 0; i < 10; i++){
        x += 1;
    }
    if(x == 10){
        print("test 1: rätt");
    }
    else{
        print(fel);
    }
    
    int y = 0;
    while(True){
        if(y == 9){
            break;
        }
        y++;
    }
    if(y == 9){
        print("test 2: rätt");
    }
    else {
        print(fel);
    }

    int q = 0;
    int e = 0;
    while(q <= 3){
        for(int i = 0; i < 10; i++){
            e++;
        }
        q++;
    }

    if(e == 40){
        print("test 3: rätt");
    }
    else{
        print(fel);
    }
}